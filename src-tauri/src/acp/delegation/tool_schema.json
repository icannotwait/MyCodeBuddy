[
  {
    "name": "complete_work",
    "description": "Record the workflow child's semantic conclusion. This does not terminate the child.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["approve", "approve_with_minors", "request_changes", "block", "done", "done_with_concerns", "blocked"]
        },
        "summary": {"type": "string", "maxLength": 4096},
        "report_file": {"type": "string", "maxLength": 1024}
      }
    }
  },
  {
    "name": "delegate_to_agent",
    "description": "Start an asynchronous isolated sub-agent; task must include all context. Fan out, then Join. Pass profile_id for a named profile. Admission failure/unknown requires explicit replacement.",
    "inputSchema": {
      "type": "object",
      "required": ["agent_type", "task", "correlation_id"],
      "properties": {
        "agent_type": {
          "type": "string",
          "enum": [
            "claude_code",
            "codex",
            "open_code",
            "gemini",
            "cline",
            "hermes",
            "code_buddy",
            "kimi_code",
            "pi",
            "grok",
            "cursor"
          ]
        },
        "profile_id": { "type": "string" },
        "profile_label": { "type": "string" },
        "task": { "type": "string" },
        "correlation_id": {
          "type": "string",
          "description": "Fresh per call."
        },
        "recovery_authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "working_dir": {
          "type": "string",
          "description": "Absolute; defaults to parent."
        },
        "work_unit_key": {
          "type": "string",
          "maxLength": 200,
          "description": "Recovery key."
        },
        "replaces_task_id": {
          "type": "string",
          "description": "Pair with replacement_reason."
        },
        "replacement_reason": {
          "type": "string",
          "enum": ["unresumable", "budget_exhausted_continue", "not_supported", "admission_failed", "admission_unknown"],
          "description": "Admission failure/unknown requires replacement; cancellation/stall does not."
        }
      }
    }
  },
  {
    "name": "continue_delegation",
    "description": "Continue terminal task_id asynchronously with full context; never creates a child. Join via get_delegation_status.",
    "inputSchema": {
      "type": "object",
      "required": ["task_id", "task", "correlation_id"],
      "properties": {
        "task_id": { "type": "string" },
        "task": { "type": "string" },
        "correlation_id": {
          "type": "string",
          "description": "Fresh per invocation."
        },
        "recovery_authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "work_unit_key": {
          "type": "string",
          "maxLength": 200,
          "description": "Prior key if omitted; max 200."
        }
      }
    }
  },
  {
    "name": "get_delegation_status",
    "description": "Join task_ids in input order. Omit wait_ms for a snapshot; use return_when=all_terminal_or_attention with wait_ms=0. Answer attention, then re-Join running required tasks.",
    "inputSchema": {
      "type": "object",
      "required": ["task_ids"],
      "properties": {
        "task_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "return_when": {
          "type": "string",
          "enum": ["all_terminal_or_attention"]
        }
      }
    }
  },
  {
    "name": "cancel_delegation",
    "description": "Cancel only when its result is no longer wanted. timeout is non-canceling: keep waiting with get_delegation_status wait_ms for slow work. Already finished returns final result. taskfail, usercancel, and others cancel.",
    "inputSchema": {
      "type": "object",
      "required": ["task_id", "reason"],
      "properties": {
        "task_id": { "type": "string" },
        "reason": {
          "type": "string",
          "enum": ["timeout", "taskfail", "usercancel", "others"]
        }
      }
    }
  },
  {
    "name": "check_user_feedback",
    "description": "Messages are available only through this tool. Non-blocking; call before starting implementation, a significant decision, and after a meaningful sub-task. HIGH-PRIORITY; empty result means continue.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "ask_user_question",
    "description": "Render interactive cards for 1-4 related multiple-choice questions and BLOCK until submitted or dismissed. Use only for a genuinely user-owned discrete decision that cannot be resolved from the request, code, or sensible defaults. Do not ask merely whether to proceed, confirm an obvious default, or collect open-ended input. Other is added automatically. Put a recommended choice first and append ' (Recommended)' to its label. Prefer one call for related questions.",
    "inputSchema": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "Questions in this call.",
          "items": {
            "type": "object",
            "required": ["question", "header", "multiSelect", "options"],
            "properties": {
              "question": {
                "type": "string",
                "description": "Question shown to the user."
              },
              "header": {
                "type": "string",
                "maxLength": 12,
                "description": "Chip label, at most 12 characters."
              },
              "multiSelect": {
                "type": "boolean",
                "description": "Whether multiple options may be selected."
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "description": "Selectable choices.",
                "items": {
                  "type": "object",
                  "required": ["label", "description"],
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "Short choice text; append ' (Recommended)' to the first recommended choice."
                    },
                    "description": {
                      "type": "string",
                      "description": "Meaning or trade-off of this choice."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "get_session_info",
    "description": "Resolve codeg://session/ to read-only metadata and optional recent messages. Use internal conversation ID, not the agent session ID. Missing is found: false, not an error.",
    "inputSchema": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "integer" },
        "max_messages": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "request_parent_decision",
    "description": "Ask the direct parent for a blocking decision. Blocks until reply or closure; not for progress, logs, or warnings.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Decision needed; max 16 KiB UTF-8."
        }
      }
    }
  },
  {
    "name": "reply_to_delegation",
    "description": "Reply to an open direct-child Join decision. First reply wins; same reply is idempotent.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "reply"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "reply": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  {
    "name": "request_recovery_authorization",
    "description": "After typed recovery_confirmation_required, request confirmation; replay the exact rejected call with recovery_authorization_id. Server derives action, target, warning, work-unit key, and delegation target. Results include subject_kind, subject_id, allowed_action, cause_code, expires_at, and action-specific target_state or replacement_reason metadata.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind", "subject_id", "correlation_id"],
      "properties": {
        "subject_kind": {
          "type": "string",
          "enum": ["delegation_task", "workflow"]
        },
        "subject_id": { "type": "string", "minLength": 1 },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "proposed_user_reason": {
          "type": "string",
          "maxLength": 4096,
          "description": "reset_plan_lineage only; otherwise rejected."
        }
      }
    }
  },
  {
    "name": "get_workflow_capabilities",
    "description": "Discover workflow_manifest_v2.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "get_workflow_state",
    "description": "Load compact workflow index. Read plan/design/report_file for prose; use get_session_info/get_delegation_status for child/run detail.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workflow_id": { "type": "string" },
        "detail": { "type": "string", "enum": ["index"], "default": "index" }
      }
    }
  },
  {
    "name": "restart_legacy_workflow",
    "description": "Create or return the single empty protocol-v2 successor for this owned legacy root. The source stays read-only and unchanged.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_conversation_id"],
      "properties": {
        "source_conversation_id": { "type": "integer" }
      }
    }
  },
  {
    "name": "recover_workflow",
    "description": "Root only. Call get_workflow_state, then request_recovery_authorization; use its receipt. Never creates a challenge.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "recovery_authorization_id",
        "expected_manifest_revision",
        "correlation_id"
      ],
      "properties": {
        "workflow_id": { "type": "string", "minLength": 1 },
        "recovery_authorization_id": { "type": "string", "minLength": 1 },
        "expected_manifest_revision": { "type": "integer", "minimum": 1 },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    }
  },
  {
    "name": "publish_workflow_manifest",
    "description": "Publish/CAS v2 workflow manifest.",
    "inputSchema": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_kind",
        "publication_token",
        "workflow_state",
        "plan_target_rel_path",
        "risk_policy_version",
        "task_policies",
        "phases",
        "nodes",
        "edges",
        "gates"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 2 },
        "workflow_id": { "type": "string" },
        "expected_manifest_revision": { "type": "integer", "minimum": 0 },
        "plan_target_rel_path": { "type": "string" },
        "risk_policy_version": { "type": "string", "const": "b2d_task_risk_v1" },
        "task_policies": { "type": "array" }
      }
    }
  },
  {
    "name": "settle_workflow_gate",
    "description": "Root-only Design/Plan settle; v1 or v2 shape selected by durable protocol.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "gate_id",
        "expected_graph_revision",
        "summary"
      ],
      "oneOf": [
        {
          "required": ["manifest_revision", "gate_cycle", "outcome", "evidence"]
        },
        {
          "propertyNames": {
            "not": {
              "enum": ["manifest_revision", "gate_cycle", "outcome", "evidence"]
            }
          }
        }
      ],
      "properties": {
        "workflow_id": { "type": "string" },
        "gate_id": { "type": "string" },
        "expected_graph_revision": { "type": "integer", "minimum": 0 },
        "manifest_revision": { "type": "integer", "minimum": 0 },
        "gate_cycle": { "type": "integer", "minimum": 1 },
        "outcome": {
          "type": "string",
          "enum": ["approved", "changes_requested", "blocked"]
        },
        "evidence": {
          "type": "object",
          "required": ["kind"]
        },
        "expected_review_round": { "type": "integer", "minimum": 1 },
        "expected_gate_cycle": { "type": "integer", "minimum": 1 },
        "expected_outcome": {
          "type": "string",
          "enum": ["approved", "changes_requested", "blocked"]
        },
        "recovery_authorization_id": { "type": "string" },
        "summary": { "type": "string" }
      }
    }
  }
]
