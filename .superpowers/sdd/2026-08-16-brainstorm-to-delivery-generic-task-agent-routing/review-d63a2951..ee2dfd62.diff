+fn simple_route_child_conflicts<'a>(
+    key_by_child: &mut HashMap<i32, &'a str>,
+    child_id: i32,
+    key: &'a str,
+) -> bool {
+    if let Some(prior_key) = key_by_child.get(&child_id) {
+        return *prior_key != key;
+    }
+    key_by_child.insert(child_id, key);
+    false
+}
