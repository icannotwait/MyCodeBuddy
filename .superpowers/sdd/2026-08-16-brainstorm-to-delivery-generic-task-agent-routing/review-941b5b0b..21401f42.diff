+        additions: runtime.additions,
+        deletions: runtime.deletions,
+        line_counts_complete: runtime.line_counts_complete,
+        summary: None,
+        completion: None,
+        is_observed: latest.is_some() || latest_progress.is_some(),
+        retained_observed: false,
+        required: true,
+        node_outcome: None,
+        deps,
+    }
+}
