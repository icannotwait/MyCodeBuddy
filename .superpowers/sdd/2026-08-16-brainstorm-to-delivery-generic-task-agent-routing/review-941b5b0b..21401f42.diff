+        match latest.status {
+            DelegationRunStatus::Reserving => ProjectedNodeStatus::Reserving,
+            DelegationRunStatus::Running => ProjectedNodeStatus::Running,
+            DelegationRunStatus::Completed if stale_review => ProjectedNodeStatus::WaitingReview,
