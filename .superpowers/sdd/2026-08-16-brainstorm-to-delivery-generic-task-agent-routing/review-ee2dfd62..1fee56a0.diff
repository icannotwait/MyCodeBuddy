+fn simple_route_display_title(task_title: &str, route_label: &str) -> String {
+    const MAX_SIMPLE_ROUTE_TITLE_CHARS: usize = 200;
+    redact_display_string(&format!("{task_title}: {route_label}"))
+        .chars()
+        .take(MAX_SIMPLE_ROUTE_TITLE_CHARS)
+        .collect()
+}
