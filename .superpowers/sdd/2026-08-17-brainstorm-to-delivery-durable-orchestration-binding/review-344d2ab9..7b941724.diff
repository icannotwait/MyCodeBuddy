+            })
+            .await
+            .unwrap();
+        assert_eq!(
+            first.total_rows, 4,
+            "union must deduplicate keyed same-namespace rows"
+        );
+        assert_eq!(
+            first
+                .runs
+                .iter()
+                .map(|row| row.task_id.as_str())
+                .collect::<Vec<_>>(),
