+                    panic!("replay must use the cache")
+                })
+                .await
+                .unwrap(),
+            later
+        );
+
+        for changed in [
+            OrchestrationBindingQueryRequest {
+                namespace: "another-namespace".into(),
+                ..later_request.clone()
