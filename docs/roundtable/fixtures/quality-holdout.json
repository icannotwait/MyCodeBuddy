        {
          "check_id": "tradeoff-03-risk",
          "check_type": "minority_risk",
          "opportunity": "少数意见要求显式标记资料版本分裂"
        }
      ]
    },
    {
      "id": "tradeoff-04",
      "family": "plan_tradeoff",
      "topic": "比较失败即停与在剩余预算内换一名成员继续的方案。",
      "checks": [
        {
          "check_id": "tradeoff-04-error",
          "check_type": "seeded_error",
          "opportunity": "把缺席成员计为同意"
