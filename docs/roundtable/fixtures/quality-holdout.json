        {
          "check_id": "tradeoff-01-risk",
          "check_type": "minority_risk",
          "opportunity": "少数意见认为串行会错过时间窗口内的反例"
        }
      ]
    },
    {
      "id": "tradeoff-02",
      "family": "plan_tradeoff",
      "topic": "比较短输出配额与允许一次较长主持综合的方案。",
