{
  "contract_profile": "roundtable_plan_1_2",
  "schema_version": 1,
  "tasks": [
    {
      "id": "fact-01",
      "family": "fact_check",
      "topic": "核对一份发布说明中的版本号、破坏性变更和回滚步骤是否与给定变更记录一致。",
      "checks": [
        {
          "check_id": "fact-01-error",
          "check_type": "seeded_error",
          "opportunity": "把 1.2.0 写成 1.20，并省略迁移步骤"
        },
        {
          "check_id": "fact-01-response",
          "check_type": "substantive_response",
          "opportunity": "指出遗漏的迁移步骤并引用变更记录"
        },
        {
          "check_id": "fact-01-risk",
          "check_type": "minority_risk",
          "opportunity": "仅有一名成员指出回滚窗口与数据迁移不可逆"
        }
      ]
    },
    {
      "id": "fact-02",
      "family": "fact_check",
      "topic": "核对事故时间线里的告警时间、影响范围和修复提交是否互相矛盾。",
      "checks": [
        {
          "check_id": "fact-02-error",
          "check_type": "seeded_error",
          "opportunity": "修复提交时间早于告警，但被写成事故原因"
        },
        {
          "check_id": "fact-02-response",
          "check_type": "substantive_response",
          "opportunity": "要求用原始日志区分触发时间和提交时间"
        },
        {
          "check_id": "fact-02-risk",
          "check_type": "minority_risk",
          "opportunity": "少数意见认为第三方依赖时钟偏移未被排除"
        }
      ]
    },
    {
      "id": "fact-03",
      "family": "fact_check",
      "topic": "核对容量表中的并发、超时和字节上限是否与所附配置原文一致。",
      "checks": [
        {
          "check_id": "fact-03-error",
          "check_type": "seeded_error",
          "opportunity": "把单次输出上限 8 KiB 写成房间总上限"
        },
        {
          "check_id": "fact-03-response",
          "check_type": "substantive_response",
          "opportunity": "区分单次输出、插话和房间预算三个量"
        },
        {
          "check_id": "fact-03-risk",
          "check_type": "minority_risk",
          "opportunity": "少数意见指出未知用量不能被当成零"
        }
      ]
    },
    {
      "id": "fact-04",
      "family": "fact_check",
      "topic": "核对引用文献中的样本数、失败数和结论句是否被调换。",
      "checks": [
        {
          "check_id": "fact-04-error",
          "check_type": "seeded_error",
          "opportunity": "把 12 次失败写成 12 次成功"
        },
        {
          "check_id": "fact-04-response",
          "check_type": "substantive_response",
          "opportunity": "按原文表格逐项核对分子和分母"
        },
        {
          "check_id": "fact-04-risk",
          "check_type": "minority_risk",
          "opportunity": "少数意见要求保留未回报的样本而不是删除"
        }
      ]
    },
    {
      "id": "tradeoff-01",
      "family": "plan_tradeoff",
      "topic": "在固定房间预算下比较串行深评与有限并行复核。",
      "checks": [
        {
          "check_id": "tradeoff-01-error",
          "check_type": "seeded_error",
          "opportunity": "声称并行不会增加不确定收尾时间"
        },
        {
          "check_id": "tradeoff-01-response",
          "check_type": "substantive_response",
          "opportunity": "回应并行清理超时会占用后续阶段预算"
