          "check_id": "tradeoff-02-risk",
          "check_type": "minority_risk",
          "opportunity": "少数意见指出短配额会系统性丢掉低置信风险"
        }
      ]
    },
    {
      "id": "tradeoff-03",
      "family": "plan_tradeoff",
      "topic": "比较冻结快照与允许讨论中更新资料的方案。",
      "checks": [
        {
          "check_id": "tradeoff-03-error",
          "check_type": "seeded_error",
