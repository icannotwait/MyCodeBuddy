# Copy to the machine only (never commit real values).
# Paths below match the drawcode box layout; override if yours differ.

# CODEG_TOKEN lives ONLY as a file mode 600:
#   openssl rand -hex 16 > /workspace/codeg-data/CODEG_TOKEN
#   chmod 600 /workspace/codeg-data/CODEG_TOKEN

# Optional overrides used by boot scripts:
# CODEG_DATA_DIR=/workspace/codeg-data
# CODEG_STATIC_DIR=/workspace/codeg-dist/web
# CODEG_MCP_BIN=/workspace/codeg-dist/codeg-mcp
# CF_CONFIG=$HOME/.cloudflared/config.yml
# PI_ACP_PI_COMMAND=$HOME/.local/bin/pi
