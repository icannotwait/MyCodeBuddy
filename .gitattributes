# Force LF for TypeScript sources so prettier/eslint (endOfLine: lf) is
# reproducible on Windows checkouts even when core.autocrlf=true.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf

# The bundled ui-render skill is compiled into the binary (`include_str!` in
# src-tauri/src/commands/generative_ui.rs), installed for agents byte for byte,
# and must equal what src/lib/json-render/skill.ts generates, which is LF.
# Windows checkouts convert text to CRLF by default (core.autocrlf), so pin it.
src-tauri/genui/** text eol=lf

# Keep vendored Superpowers files byte-identical to upstream. This also
# keeps extensionless Bash helpers executable under Git Bash on Windows.
# Science skills are embedded with `include_dir!` and installed byte for byte;
# a CRLF checkout would push SKILL.md past the experts compaction limit.
src-tauri/experts/** text eol=lf
src-tauri/science/** text eol=lf
